[Unit]
Description=RTSP camera recorder (record_cams.py)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=@QUOTED_PROJECT_DIR@

[Service]
Type=simple
User=@SERVICE_USER@
WorkingDirectory=@PROJECT_DIR@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 record_cams.py
# Ctrl+C 等同 SIGINT，讓 ffmpeg 正常收尾 mp4
KillSignal=SIGINT
TimeoutStopSec=20
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
